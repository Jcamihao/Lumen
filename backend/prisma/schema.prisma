generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AuthChallengeType {
  MFA_LOGIN
  MFA_EMAIL_BYPASS
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// Como o dinheiro se moveu (etiqueta opcional do lancamento). Credito NAO gera
// fatura/parcela: hoje e so uma marcacao, o saldo nao muda.
enum PaymentMethod {
  PIX
  CREDIT
  DEBIT
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  PLANNED
  ACTIVE
  ACHIEVED
  PAUSED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum InsightType {
  PRODUCTIVITY
  FINANCE
  GOAL
  ROUTINE
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ForecastRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  REMINDER
  INSIGHT
  FORECAST
  IMPORT
  SYSTEM
}

enum SupportRequestType {
  FEEDBACK
  BUG_REPORT
}

enum SupportRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum SupportRequestSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImportJobStatus {
  PREVIEWED
  IMPORTED
  FAILED
}

enum ReceiptScanStatus {
  PREVIEWED
  IMPORTED
  FAILED
}

model User {
  id                            String                 @id @default(uuid())
  name                          String
  email                         String                 @unique
  passwordHash                  String
  avatarUrl                     String?
  role                          UserRole               @default(USER)
  phone                         String?
  birthDate                     DateTime?
  occupation                    String?
  /// Objetivo principal declarado no cadastro (texto livre). Usado pelo
  /// Selah como contexto e para sugerir criar a primeira meta quando o
  /// usuario ainda nao tem nenhuma cadastrada.
  primaryGoal                   String?
  preferredCurrency             String                 @default("BRL")
  monthlyIncome                 Decimal                @default(0) @db.Decimal(12, 2)
  // Reaproveitado como dia de fechamento do ciclo de credito (nunca foi usado
  // para nada antes disto: so era coletado no cadastro e guardado).
  monthClosingDay               Int                    @default(30)
  // Dia de vencimento da fatura (so informativo por enquanto; nao gera lembrete).
  creditDueDay                  Int?
  // false (padrao): teto do ciclo so soma paymentMethod=CREDIT (comportamento original).
  // true: soma toda EXPENSE do ciclo (credito+debito+PIX+boleto), para quem trata o
  // "limite" como um teto geral de gastos, nao so do cartao.
  creditCycleCountAllPayments   Boolean                @default(false)
  timezone                      String                 @default("America/Sao_Paulo")
  /// Ultimo resumo semanal enviado por email pelo pulso agendado do Selah.
  /// Null = nunca recebeu. Evita reenviar no mesmo ciclo semanal.
  lastWeeklyDigestAt            DateTime?
  emailVerifiedAt               DateTime?
  emailWeeklyDigest             Boolean                @default(true)
  emailReminders                Boolean                @default(true)
  emailInsightAlerts            Boolean                @default(true)
  emailBillReminders            Boolean                @default(true)
  privacyNoticeAcceptedAt       DateTime?
  privacyNoticeVersion          String?
  aiAssistantEnabled            Boolean                @default(false)
  aiAssistantConsentAt          DateTime?
  aiAssistantConsentVersion     String?
  mfaEnabledAt                  DateTime?
  mfaLastVerifiedAt             DateTime?
  mfaLastTotpStep               Int?
  mfaTotpSecretEncrypted        String?
  mfaPendingTotpSecretEncrypted String?
  mfaRecoveryCodes              Json?
  lastLoginAt                   DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  tasks                         Task[]
  taskCategories                TaskCategory[]
  transactions                  Transaction[]
  financeCategories             FinanceCategory[]
  goals                         Goal[]
  reminders                     Reminder[]
  insights                      Insight[]
  forecasts                     Forecast[]
  forecastSnapshots             ForecastSnapshot[]
  importJobs                    ImportJob[]
  receiptScans                  ReceiptScan[]
  notifications                 Notification[]
  supportRequests               SupportRequest[]
  assistantTurns                AssistantTurn[]
  recurringTransactions         RecurringTransaction[]
  creditCycleCeilings           CreditCycleCeiling[]
  envelopes                     Envelope[]
  installmentPurchases          InstallmentPurchase[]
  authSessions                  AuthSession[]
  authChallenges                AuthChallenge[]
  tagGroups                     TagGroup[]
  subscriptions                 Subscription[]
  selahUsage                    SelahUsage[]
  conversationSessions          ConversationSession[]
  conversationEvents            ConversationEvent[]
  whatsappLink                  WhatsappLink?
  whatsappLinkCodes             WhatsappLinkCode[]

  @@index([email])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  // Tokens ja substituidos ({hash, retiredAt}), aceitos por uma janela curta apos a rotacao
  // (abas abrindo juntas, retry de rede). Fora da janela, reuso revoga a sessao.
  recentRefreshTokenHashes Json?
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model AuthChallenge {
  id          String            @id @default(uuid())
  userId      String
  type        AuthChallengeType
  expiresAt   DateTime
  completedAt DateTime?
  token       String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt, completedAt])
  @@index([expiresAt])
}

model TaskCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([userId, name])
  @@index([userId])
}

model FinanceCategory {
  id                    String                 @id @default(uuid())
  userId                String
  name                  String
  color                 String
  icon                  String?
  type                  TransactionType
  // Teto mensal de gastos (so faz sentido em EXPENSE); null = sem orcamento.
  monthlyBudget         Decimal?               @db.Decimal(12, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  installmentPurchases  InstallmentPurchase[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model Goal {
  id              String        @id @default(uuid())
  userId          String
  title           String
  description     String?
  /// Null = "cofrinho" sem proposito definido (ex.: reserva de emergencia).
  /// Uma meta sem alvo nunca vira ACHIEVED sozinha (nao ha linha de chegada).
  targetAmount    Decimal?      @db.Decimal(12, 2)
  currentAmount   Decimal       @default(0) @db.Decimal(12, 2)
  targetDate      DateTime?
  status          GoalStatus    @default(ACTIVE)
  /// Valor do aporte automatico mensal. Null = sem recorrencia configurada.
  recurringAmount Decimal?      @db.Decimal(12, 2)
  /// Dia do mes (1-28) em que o aporte automatico roda no pulse scan.
  recurringDay    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           Task[]
  transactions    Transaction[]
  reminders       Reminder[]

  @@index([userId, status])
}

model Task {
  id                 String        @id @default(uuid())
  userId             String
  title              String
  description        String?
  dueDate            DateTime?
  status             TaskStatus    @default(PENDING)
  priority           TaskPriority  @default(MEDIUM)
  categoryId         String?
  isRecurring        Boolean       @default(false)
  recurrenceRule     String?
  streakCount        Int           @default(0)
  longestStreak      Int           @default(0)
  hasFinancialImpact Boolean       @default(false)
  estimatedAmount    Decimal?      @db.Decimal(12, 2)
  linkedGoalId       String?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal               Goal?         @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  subtasks           TaskSubtask[]
  transactions       Transaction[]
  reminders          Reminder[]

  @@index([userId, status, dueDate])
  @@index([linkedGoalId])
}

model TaskSubtask {
  id          String    @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model Transaction {
  id                     String                @id @default(uuid())
  userId                 String
  type                   TransactionType
  description            String
  amount                 Decimal               @db.Decimal(12, 2)
  date                   DateTime
  categoryId             String?
  linkedTaskId           String?
  linkedGoalId           String?
  // Preenchido nos lancamentos gerados por uma conta fixa/recorrente.
  recurringTransactionId String?
  paymentMethod          PaymentMethod?
  // Marca o gasto como "de dentro" de um envelope (ex.: gasolina): nao
  // desconta de nenhum teto geral, so do saldo do proprio envelope.
  envelopeId             String?
  // Preenchidos nos lancamentos gerados por uma compra parcelada (materializer).
  installmentPurchaseId  String?
  installmentNumber      Int?
  installmentsTotal      Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  category               FinanceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  envelope               Envelope?             @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  installmentPurchase    InstallmentPurchase?  @relation(fields: [installmentPurchaseId], references: [id], onDelete: SetNull)
  task                   Task?                 @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  goal                   Goal?                 @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  receiptScan            ReceiptScan?
  reminders              Reminder[]

  // Uma conta fixa gera no maximo um lancamento por data (NULL nao conflita).
  @@unique([recurringTransactionId, date])
  // Uma compra parcelada gera no maximo um lancamento por numero de parcela.
  @@unique([installmentPurchaseId, installmentNumber])
  @@index([userId, type, date])
  @@index([linkedTaskId])
  @@index([linkedGoalId])
}

// Conta fixa ou recorrente (aluguel, assinatura, salario). O lancamento e
// gerado sozinho na data de vencimento; editar o modelo so afeta os proximos.
// Teto editavel do ciclo de credito aberto no momento. Uma linha por ciclo
// (chaveada pela data em que ELE fecha): o teto de um ciclo passado fica
// congelado, so o aberto pode ser editado.
model CreditCycleCeiling {
  id          String   @id @default(uuid())
  userId      String
  closingDate DateTime
  ceiling     Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, closingDate])
  @@index([userId, closingDate])
}

// Valor reservado que se recarrega todo mes e NAO desconta de nenhum teto
// geral (ex.: "Gasolina"). O que sobra vira saldo acumulado pro mes seguinte
// (mesmo espirito de um envelope de dinheiro de verdade).
model Envelope {
  id            String          @id @default(uuid())
  userId        String
  name          String
  color         String
  icon          String?
  monthlyAmount Decimal         @db.Decimal(12, 2)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topUps        EnvelopeTopUp[]
  transactions  Transaction[]

  @@unique([userId, name])
  @@index([userId, isActive])
}

// Um "deposito" mensal no envelope. O valor fica congelado no mes em que foi
// criado (se o usuario mudar monthlyAmount depois, so os meses seguintes
// mudam) — mesmo padrao do CreditCycleCeiling, so que automatico em vez de
// digitado pelo usuario.
model EnvelopeTopUp {
  id         String   @id @default(uuid())
  envelopeId String
  // Primeiro dia do mes a que este deposito se refere (meia-noite UTC).
  month      DateTime
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, month])
}

// Compra parcelada no credito. Reaproveita o mecanismo de gerar lancamentos
// futuros das contas fixas (RecurringTransaction/materializer), mas gera
// exatamente installmentsTotal vezes e para (nao repete pra sempre).
model InstallmentPurchase {
  id                    String           @id @default(uuid())
  userId                String
  description           String
  totalAmount           Decimal          @db.Decimal(12, 2)
  // Valor de cada parcela, exceto a ultima (que absorve a sobra do
  // arredondamento pra soma bater exatamente com totalAmount).
  installmentAmount     Decimal          @db.Decimal(12, 2)
  installmentsTotal     Int
  installmentsGenerated Int              @default(0)
  categoryId            String?
  paymentMethod         PaymentMethod?
  // Dia do mes da 1a parcela; mes curto usa o ultimo dia (mesma regra das contas fixas).
  anchorDay             Int
  // Proxima parcela a gerar; null quando ja gerou todas (installmentsGenerated=installmentsTotal).
  nextDueDate           DateTime?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions          Transaction[]

  @@index([userId, isActive, nextDueDate])
}

model RecurringTransaction {
  id              String              @id @default(uuid())
  userId          String
  type            TransactionType
  description     String
  amount          Decimal             @db.Decimal(12, 2)
  categoryId      String?
  paymentMethod   PaymentMethod?
  frequency       RecurrenceFrequency
  // Dia do mes de referencia (MONTHLY/YEARLY). Em mes mais curto usa o ultimo dia.
  anchorDay       Int
  // Proxima data (sem hora, meia-noite UTC) que ainda vai virar lancamento.
  nextDueDate     DateTime
  endDate         DateTime?
  isActive        Boolean             @default(true)
  lastGeneratedAt DateTime?
  // Ultimo nextDueDate ja avisado por e-mail (evita reenviar o mesmo vencimento).
  lastReminderForDate DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        FinanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions    Transaction[]

  @@index([userId, isActive, nextDueDate])
}

model Reminder {
  id            String         @id @default(uuid())
  userId        String
  title         String
  remindAt      DateTime
  taskId        String?
  transactionId String?
  goalId        String?
  status        ReminderStatus @default(SCHEDULED)
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, remindAt, status])
}

model Insight {
  id          String          @id @default(uuid())
  userId      String
  type        InsightType
  message     String
  severity    InsightSeverity
  metadata    Json?
  /// Identidade estavel da situacao detectada. Sobrevive ao refresh para que
  /// o mesmo alerta nao seja notificado duas vezes.
  fingerprint String
  /// Quando a notificacao desse insight foi disparada. Null = ainda nao avisado.
  notifiedAt  DateTime?
  /// Quando o alerta foi escalado por email por ter ficado CRITICAL e
  /// notificado sem resolucao por dias seguidos. Null = ainda nao escalado.
  escalatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, severity, createdAt])
  @@index([userId, notifiedAt])
}

model Forecast {
  id               String            @id @default(uuid())
  userId           String
  predictedBalance Decimal           @db.Decimal(12, 2)
  riskLevel        ForecastRiskLevel
  referenceDate    DateTime          @default(now())
  factors          Json?
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, referenceDate])
}

/// Retrato de uma previsao no momento em que foi calculada, pra comparar
/// depois com o saldo real quando targetDate chega — Forecast sozinho so
/// guarda a ultima previsao, sem historico de acerto/erro.
model ForecastSnapshot {
  id               String    @id @default(uuid())
  userId           String
  predictedBalance Decimal   @db.Decimal(12, 2)
  predictedAt      DateTime  @default(now())
  targetDate       DateTime
  actualBalance    Decimal?  @db.Decimal(12, 2)
  errorPercent     Decimal?  @db.Decimal(7, 2)
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetDate])
  @@index([userId, resolvedAt])
}

model ImportJob {
  id               String          @id @default(uuid())
  userId           String
  fileName         String
  status           ImportJobStatus @default(PREVIEWED)
  totalRows        Int             @default(0)
  importedRows     Int             @default(0)
  deduplicatedRows Int             @default(0)
  previewData      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model TagGroup {
  id           String        @id @default(uuid())
  userId       String
  name         String
  /// Cor em hex (#RRGGBB) usada pra destacar o grupo na UI. Opcional — sem
  /// cor, a UI cai no estilo padrao de tag.
  color        String?
  /// Grupos que o app cria automaticamente pro usuario (ver DEFAULT_TAG_GROUPS).
  /// Sinalizacao apenas — o usuario pode renomear ou apagar normalmente.
  isDefault    Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptScans ReceiptScan[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model ReceiptScan {
  id                  String            @id @default(uuid())
  userId              String
  fileName            String
  mimeType            String
  status              ReceiptScanStatus @default(PREVIEWED)
  merchantName        String?
  documentNumber      String?
  purchaseDate        DateTime?
  totalAmount         Decimal           @db.Decimal(12, 2)
  subtotalAmount      Decimal?          @db.Decimal(12, 2)
  taxAmount           Decimal?          @db.Decimal(12, 2)
  currency            String            @default("BRL")
  confidence          String            @default("medium")
  rawText             String?
  previewData         Json?
  importedAt          DateTime?
  transactionId       String?           @unique
  /// Grupo escolhido pelo usuario ANTES do upload (ex.: "Padaria"). Preenchido
  /// no preview e imutavel no commit. Nulo = nota de antes desse recurso, fora
  /// da comparacao entre notas.
  tagGroupId          String?
  /// Escolha do usuario feita junto com o grupo, antes do upload: comparar
  /// esta nota com a anterior do mesmo grupo assim que ela for confirmada.
  /// Default false — a comparacao e opcional, nao automatica.
  compareWithPrevious Boolean           @default(false)
  /// Chave de acesso (44 digitos, DV valido), gravada na previa para checar nota repetida.
  /// Nula em notas antigas, que seguem so pela regra de duplicata por valor e data.
  accessKey           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction         Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  tagGroup            TagGroup?         @relation(fields: [tagGroupId], references: [id], onDelete: SetNull)
  items               ReceiptScanItem[]

  @@index([userId, status, createdAt])
  @@index([purchaseDate])
  @@index([tagGroupId])
  @@index([userId, accessKey])
}

model ReceiptScanItem {
  id            String      @id @default(uuid())
  receiptScanId String
  description   String
  quantity      Decimal     @default(1) @db.Decimal(10, 3)
  unitPrice     Decimal?    @db.Decimal(12, 2)
  totalPrice    Decimal     @db.Decimal(12, 2)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  receiptScan   ReceiptScan @relation(fields: [receiptScanId], references: [id], onDelete: Cascade)

  @@index([receiptScanId, sortOrder])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model SupportRequest {
  id            String                  @id @default(uuid())
  userId        String
  type          SupportRequestType
  status        SupportRequestStatus    @default(OPEN)
  severity      SupportRequestSeverity?
  subject       String
  message       String
  emailSnapshot String
  screenPath    String?
  appVersion    String?
  deviceInfo    String?
  // Preenchidos pela pagina de feedback dos testadores (nota 1-5 e area do app).
  rating        Int?
  area          String?
  // O usuario autorizou a equipe a chamar para conversar sobre este feedback.
  canContact    Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

model AssistantTurn {
  id        String   @id @default(uuid())
  userId    String
  question  String
  answer    String
  focusArea String?
  source    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum BillingPlan {
  INDIVIDUAL
  SHARED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionSource {
  ASAAS
  GRANT
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id                  String             @id @default(uuid())
  ownerUserId         String
  plan                BillingPlan
  status              SubscriptionStatus @default(PENDING)
  source              SubscriptionSource
  interval            BillingInterval?
  seats               Int                @default(1)
  // null + GRANT = sem fim
  currentPeriodEnd    DateTime?
  pastDueSince        DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  asaasCheckoutId     String?            @unique
  asaasSubscriptionId String?            @unique
  asaasCustomerId     String?
  asaasCheckoutLink   String?
  latestInvoiceUrl    String?
  grantedByUserId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status])
}

model BillingEvent {
  id              String    @id @default(uuid())
  provider        String    @default("ASAAS")
  // id do evento do Asaas: idempotencia
  externalEventId String    @unique
  type            String
  // ja SANITIZADO (sem CPF nem dado de cartao)
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([type, createdAt])
}

// 1 linha por pergunta respondida PELO SELAH (server-side).
model SelahUsage {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ConversationChannel {
  APP
  WHATSAPP
}

enum ConversationState {
  COLLECTING_FIELDS
  AWAITING_CONFIRMATION
  AWAITING_IMPORT_FILE
  AWAITING_IMPORT_REVIEW
  PROCESSING
}

enum ConversationOutcome {
  RECOGNIZED
  COMPLETED
  CANCELLED
  EXPIRED
  UNRECOGNIZED
  DUPLICATE
  ERROR
}

// Uma sessao ativa por usuario e canal. Nao existe linha = IDLE.
model ConversationSession {
  id        String              @id @default(uuid())
  userId    String
  channel   ConversationChannel
  state     ConversationState
  intent    String              // id da secao 6, ex.: "create_expense"
  // So campos ja informados ou confirmados. Nunca segredo nem conteudo bruto de documento.
  draft     Json
  // Sobe a cada mudanca do rascunho. Confirmar exige a versao que o usuario viu.
  version   Int                 @default(1)
  expiresAt DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([expiresAt])
}

// Idempotencia e metrica. Nao guarda o texto da mensagem (decisao D6).
model ConversationEvent {
  id         String              @id @default(uuid())
  userId     String
  channel    ConversationChannel
  messageId  String?             // preenchido em mensagens; nulo em confirmar/cancelar por botao
  intent     String?
  outcome    ConversationOutcome
  // Preenchido so quando uma acao financeira foi aplicada: `${sessionId}:${version}`.
  appliedKey String?             @unique
  // Id do registro criado (ex.: Transaction.id), para auditoria.
  resultRef  String?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, messageId])
  @@index([userId, createdAt])
}

// Vinculo entre um numero do WhatsApp (JID como o WA-AKG entrega) e uma conta Lumen.
// Desvincular apaga a linha. Um JID ativo em uma so conta; uma conta tem um vinculo.
model WhatsappLink {
  id        String   @id @default(uuid())
  userId    String   @unique
  jid       String   @unique
  linkedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Codigo de vinculo de uso unico. So o hash SHA-256 fica no banco.
model WhatsappLinkCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([codeHash])
}
