POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=4201

# Valores abaixo (DATABASE_URL, REDIS_URL, APP_URL, FRONTEND_APP_API_BASE_URL,
# FRONTEND_APP_WS_BASE_URL) sao para o modo host (`npm run dev`). O modo Docker
# (`npm run compose:up`) usa valores proprios fixos no docker-compose.yml, pois
# a rede interna do Docker precisa de hostnames diferentes (postgres/redis) e
# de outras portas (as mapeadas em *_HOST_PORT acima).
DATABASE_URL=postgresql://lumen:lumen@localhost:5433/lumen?schema=public
REDIS_URL=redis://localhost:6380

PORT=3000
APP_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://localhost:8100,http://127.0.0.1:8100,capacitor://localhost,http://localhost
APP_SWAGGER_ENABLED=true

# Planos e limites: desligado = sem limites; ligar so quando a cobranca estiver pronta (padrao: false)
BILLING_ENABLED=false

# Troque os secrets abaixo por valores unicos e aleatorios em qualquer ambiente
# real (nao apenas dev local). Nunca reutilize os valores de exemplo.
JWT_ACCESS_SECRET=changeme-jwt-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_NAME=lumen.refreshToken
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_MFA_ENABLED=false
AUTH_MFA_ENCRYPTION_SECRET=changeme-mfa-encryption-secret
AUTH_MFA_ISSUER=LUMEN
AUTH_MFA_CHALLENGE_EXPIRES_IN_SECONDS=300

# URL publica do frontend, usada nos links dos emails (confirmar, redefinir, descadastrar).
FRONTEND_URL=http://localhost:4200
AUTH_EMAIL_LINK_SECRET=changeme-email-link-secret
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_EMAIL_VERIFICATION_TTL_HOURS=48

CACHE_TTL_SECONDS=300

SELAH_ASSISTANT_ENABLED=false
SELAH_BASE_URL=
# Chave propria do Lumen no Selah (o Selah a define em SELAH_APP_KEYS=LumenBack:<chave>).
# Gere com: openssl rand -hex 32. E a chave que identifica o app; nao reutilize a de outro app.
SELAH_API_KEY=
# So informativo: o Selah descobre o app pela chave, nao por este header.
SELAH_SOURCE_APP=LumenBack
SELAH_ASSISTANT_ROUTE=/v1/adapters/lumen/life-assistant/chat
SELAH_RECEIPT_ROUTE=/v1/adapters/lumen/receipt-parser/parse
SELAH_TIMEOUT_MS=50000
SELAH_RECEIPT_TIMEOUT_MS=60000

RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=LUMEN
RESEND_REPLY_TO=
RESEND_TIMEOUT_MS=10000

# Sandbox por padrao; producao so na hora de ligar (ver .env.production).
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas envia no header asaas-access-token dos webhooks.
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_MS=10000

FRONTEND_APP_API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_APP_WS_BASE_URL=http://localhost:3000
FRONTEND_APP_MFA_ENABLED=false
