# Copie para .env.production no servidor e preencha os valores reais.
# NUNCA versionar o .env.production preenchido (ja esta no .gitignore).

POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=changeme-generate-strong-random-value

# Portas expostas apenas em 127.0.0.1 (o nginx do host e' quem fala com elas).
BACKEND_HOST_PORT=3010
FRONTEND_HOST_PORT=4210

APP_URL=https://api.financelumen.tech
APP_CORS_ALLOWED_ORIGINS=https://financelumen.tech,https://www.financelumen.tech
APP_SWAGGER_ENABLED=true

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=changeme-generate-strong-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-generate-strong-random-value
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REFRESH_COOKIE_NAME=lumen.refreshToken
AUTH_REFRESH_COOKIE_DOMAIN=.financelumen.tech
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_MFA_ENABLED=false
AUTH_MFA_ENCRYPTION_SECRET=changeme-generate-strong-random-value
AUTH_MFA_ISSUER=LUMEN
AUTH_MFA_CHALLENGE_EXPIRES_IN_SECONDS=300

# Links dos emails (confirmar, redefinir senha, descadastrar) apontam pra ca.
FRONTEND_URL=https://financelumen.tech
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_EMAIL_LINK_SECRET=changeme-generate-strong-random-value
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_EMAIL_VERIFICATION_TTL_HOURS=48

CACHE_TTL_SECONDS=300

SELAH_ASSISTANT_ENABLED=false
SELAH_BASE_URL=
SELAH_API_KEY=
SELAH_SOURCE_APP=LumenBack
SELAH_ASSISTANT_ROUTE=/v1/adapters/lumen/life-assistant/chat
SELAH_RECEIPT_ROUTE=/v1/adapters/lumen/receipt-parser/parse
SELAH_TIMEOUT_MS=20000
SELAH_RECEIPT_TIMEOUT_MS=60000

RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=LUMEN
RESEND_REPLY_TO=
RESEND_TIMEOUT_MS=10000

FRONTEND_APP_API_BASE_URL=https://api.financelumen.tech/api/v1
FRONTEND_APP_WS_BASE_URL=https://api.financelumen.tech
FRONTEND_APP_CLIENT_LOGGING_ENABLED=false
FRONTEND_APP_MFA_ENABLED=false
