{
  "name": "lumen-frontend",
  "version": "1.59.32",
  "scripts": {
    "ng": "ng",
    "prestart": "node ./scripts/generate-runtime-config.mjs",
    "start": "ng serve",
    "prebuild": "node ./scripts/generate-runtime-config.mjs",
    "build": "ng build",
    "prebuild:mobile": "node ./scripts/generate-runtime-config.mjs",
    "build:mobile": "ng build --configuration production",
    "mobile:rebuild": "npm run build:mobile && npm run cap:sync",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:ios": "npx cap add ios",
    "cap:open:ios": "npx cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.32",
    "@angular/common": "^20.3.32",
    "@angular/compiler": "^20.3.32",
    "@angular/core": "^20.3.32",
    "@angular/forms": "^20.3.32",
    "@angular/platform-browser": "^20.3.32",
    "@angular/platform-browser-dynamic": "^20.3.32",
    "@angular/router": "^20.3.32",
    "@angular/service-worker": "^20.3.32",
    "@capacitor/core": "^5.7.8",
    "@capacitor/ios": "^5.7.8",
    "@capacitor/local-notifications": "^5.0.8",
    "@capacitor/preferences": "^5.0.8",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.32",
    "@capacitor/cli": "^5.7.8",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^24.43.1",
    "typescript": "~5.8.3"
  }
}